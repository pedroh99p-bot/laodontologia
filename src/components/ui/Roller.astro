---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="roller" aria-hidden="true">
  <span class="roller-line"></span>
  <span>{label}</span>
  <span class="roller-arrow">↗</span>
</div>

<style>
  .roller {
    display: flex;
    width: 2.75rem;
    min-height: 10.75rem;
    gap: 0.45rem;
    align-items: center;
    justify-content: center;
    color: var(--color-copper-dark);
    background: color-mix(in srgb, var(--color-warm-white) 88%, transparent);
    border: var(--border-width) solid var(--color-white);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-surface);
  }

  .roller span {
    font-size: 0.62rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .roller-line {
    width: 1px;
    height: 1.6rem;
    background: currentColor;
    opacity: 0.36;
  }

  .roller-arrow {
    display: grid;
    width: 1.65rem;
    height: 1.65rem;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 0.8rem;
    line-height: 1;
  }

  @media (min-width: 70rem) {
    .roller {
      width: 3.7rem;
      min-height: 14rem;
      gap: 0.65rem;
    }

    .roller span {
      font-size: var(--text-xs);
      letter-spacing: 0.35em;
    }

    .roller-line {
      height: 2.25rem;
    }

    .roller-arrow {
      width: 1.85rem;
      height: 1.85rem;
    }
  }
</style>
