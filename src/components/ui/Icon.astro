---
interface Props {
  name: "arrow-up-right" | "chat" | "instagram" | "location" | "phone";
  size?: number;
}

const { name, size = 20 } = Astro.props;
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  {
    name === "arrow-up-right" && (
      <>
        <path d="M7 17 17 7" />
        <path d="M8 7h9v9" />
      </>
    )
  }
  {
    name === "chat" && (
      <>
        <path d="M7.5 18.5 4 20l1.1-3.8A8 8 0 1 1 7.5 18.5Z" />
        <path d="M8.5 10.25h.01M12 10.25h.01M15.5 10.25h.01" />
      </>
    )
  }
  {
    name === "instagram" && (
      <>
        <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <path d="M17.5 6.75h.01" />
      </>
    )
  }
  {
    name === "location" && (
      <>
        <path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" />
        <circle cx="12" cy="10" r="2.25" />
      </>
    )
  }
  {
    name === "phone" && (
      <path d="M8.1 3.8 6.4 3a2 2 0 0 0-2.6.9l-.7 1.5c-.5 1.1-.4 2.3.1 3.3a25.3 25.3 0 0 0 12.1 12.1c1 .5 2.2.6 3.3.1l1.5-.7a2 2 0 0 0 .9-2.6l-.8-1.7a2 2 0 0 0-2.4-1l-1.8.6a16.6 16.6 0 0 1-7.5-7.5l.6-1.8a2 2 0 0 0-1-2.4Z" />
    )
  }
</svg>

<style>
  .icon {
    flex: 0 0 auto;
    stroke: currentColor;
    stroke-width: 1.65;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
