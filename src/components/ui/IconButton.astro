---
interface Props {
  label: string;
  href?: string;
  type?: "button" | "submit" | "reset";
}

const { label, href, type = "button" } = Astro.props;
---

{
  href ? (
    <a class="icon-button" href={href} aria-label={label} title={label}>
      <slot />
    </a>
  ) : (
    <button class="icon-button" type={type} aria-label={label} title={label}>
      <slot />
    </button>
  )
}

<style>
  .icon-button {
    display: inline-grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    padding: 0;
    color: var(--color-copper-dark);
    background: var(--color-warm-white);
    border: var(--border-width) solid var(--color-warm-border);
    border-radius: 50%;
    text-decoration: none;
  }

  .icon-button :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
