---
interface Props {
  items: readonly string[];
  tone?: "light" | "dark";
}

const { items, tone = "dark" } = Astro.props;
const sequence = [...items, ...items];
---

<div class:list={["text-roller", `text-roller--${tone}`]} aria-hidden="true">
  <div class="text-roller__track">
    {sequence.map((item) => <span>{item} ✦</span>)}
  </div>
</div>

<style>
  .text-roller {
    overflow: hidden;
    padding-block: 0.85rem;
    border-block: 1px solid currentColor;
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .text-roller--dark {
    color: var(--color-copper-dark);
  }
  .text-roller--light {
    color: var(--color-ivory);
  }
  .text-roller__track {
    display: inline-flex;
    min-width: max-content;
    gap: 2.2rem;
  }
</style>
