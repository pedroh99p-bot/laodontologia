---
import { media } from "../../config/media";

const logo = media.logoHorizontal.asset;

if (!logo) {
  throw new Error("Logo da abertura não está disponível.");
}
---

<div class="page-intro" data-page-intro aria-hidden="true">
  <div class="page-intro__brand">
    <img
      src={logo.url}
      width={logo.width}
      height={logo.height}
      alt=""
      decoding="sync"
    />
    <span></span>
    <p>Cuidado em cada detalhe</p>
  </div>
</div>

<script>
  const pageIntro = document.querySelector<HTMLElement>("[data-page-intro]");
  if (pageIntro) {
    const removeIntro = () => pageIntro.remove();
    pageIntro.addEventListener("animationend", (event) => {
      if ((event as AnimationEvent).animationName === "page-intro-exit") {
        removeIntro();
      }
    });
    window.setTimeout(removeIntro, 1800);
  }
</script>

<style>
  .page-intro {
    position: fixed;
    z-index: calc(var(--z-modal) + 10);
    inset: 0;
    display: grid;
    place-items: center;
    padding: var(--space-6);
    background:
      radial-gradient(circle at center, rgb(168 84 47 / 8%), transparent 18rem),
      var(--color-ivory);
    animation: page-intro-exit 0.55s 0.95s var(--ease-emphasized) forwards;
  }

  .page-intro__brand {
    display: grid;
    width: min(18rem, 72vw);
    justify-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .page-intro__brand img {
    width: min(14rem, 62vw);
    height: auto;
    object-fit: contain;
    animation: page-intro-logo 0.8s var(--ease-emphasized) both;
  }

  .page-intro__brand span {
    width: 0;
    height: 1px;
    background: var(--color-copper-dark);
    animation: page-intro-line 0.65s 0.25s var(--ease-emphasized) forwards;
  }

  .page-intro__brand p {
    color: var(--color-copper-dark);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0;
    animation: page-intro-copy 0.5s 0.4s var(--ease-emphasized) forwards;
  }

  @keyframes page-intro-logo {
    from {
      opacity: 0;
      transform: translateY(0.8rem) scale(0.96);
      filter: blur(7px);
    }

    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  @keyframes page-intro-line {
    to {
      width: 4.5rem;
    }
  }

  @keyframes page-intro-copy {
    to {
      opacity: 1;
    }
  }

  @keyframes page-intro-exit {
    to {
      visibility: hidden;
      opacity: 0;
      transform: scale(1.025);
      pointer-events: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-intro {
      display: none;
    }
  }
</style>
