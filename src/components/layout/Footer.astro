---
import { legalNavigation } from "../../config/navigation";
import { siteConfig } from "../../config/site";
import Container from "../ui/Container.astro";

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <Container>
    <div class="footer-grid">
      <div>
        <p class="brand">{siteConfig.brandName}</p>
        <p>{siteConfig.existingTagline}</p>
      </div>

      <div>
        <p class="label">Endereço</p>
        <address>{siteConfig.address.formatted}</address>
      </div>

      <div>
        <p class="label">Contato</p>
        <ul role="list">
          <li>
            <a href={siteConfig.telephoneHref}>{siteConfig.phoneDisplay}</a>
          </li>
          <li><a href={siteConfig.whatsappUrl}>WhatsApp</a></li>
          <li>
            <a href={siteConfig.instagramUrl}>
              @{siteConfig.instagramUsername}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <p class="label">Responsáveis</p>
        <ul role="list">
          {
            siteConfig.professionals.map((professional) => (
              <li>
                {professional.displayName} · {professional.cro}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="footer-base">
      <p>© {currentYear} {siteConfig.brandName}.</p>
      <nav aria-label="Legal">
        <ul role="list">
          {
            legalNavigation.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-8) var(--space-5);
    color: var(--color-ivory);
    background: var(--color-graphite);
  }

  .footer-grid {
    display: grid;
    gap: var(--space-6);
  }

  .brand {
    margin-bottom: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }

  .label {
    margin-bottom: var(--space-2);
    color: var(--color-sage);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  address {
    max-width: 34ch;
    font-style: normal;
  }

  ul {
    display: grid;
    gap: var(--space-1);
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    color: var(--color-sage);
    border-top: var(--border-width) solid rgb(255 255 255 / 16%);
    font-size: var(--text-sm);
  }

  @media (min-width: 48rem) {
    .footer-grid {
      grid-template-columns: 1.1fr 1.5fr 0.8fr 1.2fr;
    }
  }
</style>
