---
import { legalNavigation } from "../../config/navigation";
import { siteConfig } from "../../config/site";
import Container from "../ui/Container.astro";
import Icon from "../ui/Icon.astro";

const currentYear = new Date().getFullYear();
---

<footer class="site-footer" id="rodape">
  <Container>
    <div class="footer-lead">
      <a class="brand" href="/" aria-label={`${siteConfig.brandName}, início`}>
        <span class="brand-mark" aria-hidden="true">LA</span>
        <span>
          <strong>{siteConfig.brandName}</strong>
          <small>{siteConfig.existingTagline}</small>
        </span>
      </a>
      <p>Odontologia no Recreio dos Bandeirantes.</p>
    </div>

    <div class="footer-grid">
      <div>
        <p class="label">Endereço</p>
        <address>{siteConfig.address.formatted}</address>
      </div>

      <div>
        <p class="label">Contato</p>
        <ul role="list">
          <li>
            <a
              href={siteConfig.telephoneHref}
              data-track-event="phone_click"
              data-cta-location="footer"
            >
              <Icon name="phone" size={18} />
              {siteConfig.phoneDisplay}
            </a>
          </li>
          <li>
            <a
              href={siteConfig.whatsappUrl}
              data-track-event="whatsapp_click"
              data-cta-location="footer"
            >
              <Icon name="chat" size={18} />
              WhatsApp
            </a>
          </li>
          <li>
            <a href={siteConfig.instagramUrl}>
              <Icon name="instagram" size={18} />
              @{siteConfig.instagramUsername}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <p class="label">Profissionais</p>
        <ul class="professionals" role="list">
          {
            siteConfig.professionals.map((professional) => (
              <li>
                <strong>{professional.displayName}</strong>
                <span>{professional.cro}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="footer-base">
      <p>© {currentYear} {siteConfig.brandName}.</p>
      <nav aria-label="Links legais">
        <ul role="list">
          {
            legalNavigation.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
          <li><a href="#topo">Voltar ao topo</a></li>
        </ul>
      </nav>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    padding-block: clamp(3.5rem, 7vw, 6rem) var(--space-5);
    color: var(--color-ivory);
    background: var(--color-graphite);
  }

  .footer-lead {
    display: grid;
    gap: var(--space-5);
    padding-bottom: var(--space-7);
    border-bottom: 1px solid rgb(255 255 255 / 13%);
  }

  .brand {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    place-items: center;
    color: #e1b9a4;
    border: 1px solid #c5805e;
    border-radius: 50%;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    letter-spacing: -0.08em;
  }

  .brand > span:last-child {
    display: grid;
    gap: 0.15rem;
  }

  .brand strong {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 400;
  }

  .brand small {
    color: var(--color-sage);
    font-size: var(--text-xs);
  }

  .footer-lead > p {
    max-width: 19ch;
    color: var(--color-sage);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: var(--leading-heading);
  }

  .footer-grid {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-7);
  }

  .label {
    margin-bottom: var(--space-4);
    color: #d49a7d;
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  address {
    max-width: 34ch;
    color: #ded9d3;
    font-style: normal;
  }

  ul {
    display: grid;
    gap: var(--space-2);
  }

  .footer-grid a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: var(--space-2);
    color: #ded9d3;
    text-decoration: none;
  }

  .footer-grid a:hover {
    color: var(--color-white);
  }

  .professionals {
    gap: var(--space-4);
  }

  .professionals li {
    display: grid;
    gap: 0.1rem;
  }

  .professionals strong {
    font-weight: 600;
  }

  .professionals span {
    color: var(--color-sage);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-5);
    color: var(--color-sage);
    border-top: 1px solid rgb(255 255 255 / 13%);
    font-size: var(--text-sm);
  }

  .footer-base ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-base a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    text-decoration: none;
  }

  @media (min-width: 38rem) {
    .footer-lead {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }

  @media (min-width: 48rem) {
    .footer-grid {
      grid-template-columns: 1.35fr 0.85fr 1fr;
    }
  }
</style>
