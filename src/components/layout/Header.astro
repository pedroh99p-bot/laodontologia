---
import { media } from "../../config/media";
import { siteConfig } from "../../config/site";
import { buildWhatsAppUrl } from "../../lib/whatsapp";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import Icon from "../ui/Icon.astro";

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const whatsappUrl = buildWhatsAppUrl();
const navbarLogo = media.logoHorizontal.asset;

if (!navbarLogo) {
  throw new Error("A logo horizontal confirmada não está disponível.");
}
---

<header
  id="topo"
  class:list={["site-header", { "site-header--overlay": overlay }]}
>
  <Container>
    <div class="header-shell">
      <a class="brand" href="/" aria-label={`${siteConfig.brandName}, início`}>
        <img
          class="brand-logo"
          src={navbarLogo.url}
          width={navbarLogo.width}
          height={navbarLogo.height}
          alt={navbarLogo.alt}
          decoding="async"
        />
      </a>

      <nav class="desktop-nav" aria-label="Principal">
        <ul role="list">
          {
            siteConfig.navigation.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="desktop-cta">
        <Button
          href={whatsappUrl}
          icon="chat"
          trackingEvent="whatsapp_click"
          trackingLocation="header"
        >
          Falar pelo WhatsApp
        </Button>
      </div>

      <a
        class="mobile-whatsapp"
        href={whatsappUrl}
        aria-label="Falar com a LA Odontologia pelo WhatsApp"
        data-track-event="whatsapp_click"
        data-cta-location="header"
      >
        <Icon name="chat" size={18} />
        <span>WhatsApp</span>
      </a>

      <details class="mobile-nav" data-mobile-menu>
        <summary>
          <span class="visually-hidden">Abrir menu de navegação</span>
          <span class="menu-lines" aria-hidden="true">
            <span></span>
            <span></span>
          </span>
        </summary>
        <nav aria-label="Principal em dispositivos móveis">
          <ul role="list">
            {
              siteConfig.navigation.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
            <li>
              <a
                class="menu-contact"
                href={whatsappUrl}
                data-track-event="whatsapp_click"
                data-cta-location="header"
              >
                Falar pelo WhatsApp
                <Icon name="arrow-up-right" size={18} />
              </a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </Container>
</header>

<style>
  .site-header {
    position: relative;
    z-index: var(--z-header);
    width: 100%;
    padding-block: var(--space-3);
  }

  .site-header--overlay {
    position: absolute;
    inset: 0 0 auto;
  }

  .header-shell {
    display: flex;
    min-height: 3.75rem;
    align-items: center;
    gap: var(--space-2);
    padding: 0.45rem;
    background: color-mix(in srgb, var(--color-warm-white) 96%, transparent);
    border: var(--border-width) solid rgb(255 255 255 / 82%);
    border-radius: var(--radius-pill);
    box-shadow: 0 0.75rem 2.5rem rgb(67 46 35 / 11%);
    backdrop-filter: blur(10px);
  }

  .brand {
    display: inline-flex;
    min-width: 0;
    min-height: 2.75rem;
    align-items: center;
    margin-right: auto;
    line-height: 1;
    text-decoration: none;
  }

  .brand-logo {
    width: clamp(6.8rem, 34vw, 10.5rem);
    height: auto;
    object-fit: contain;
  }

  .desktop-nav,
  .desktop-cta {
    display: none;
  }

  .mobile-whatsapp {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.4rem;
    padding-inline: 0.75rem;
    color: var(--color-on-copper);
    background: var(--color-copper-dark);
    border-radius: var(--radius-pill);
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
  }

  .mobile-nav {
    position: relative;
    flex: 0 0 auto;
  }

  .mobile-nav summary {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-content: center;
    list-style: none;
    color: var(--color-graphite);
    border: var(--border-width) solid var(--color-warm-border);
    border-radius: 50%;
  }

  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .menu-lines {
    display: grid;
    gap: 0.34rem;
  }

  .menu-lines > span {
    width: 1.1rem;
    height: 1px;
    background: currentColor;
    transition:
      transform var(--duration-fast) var(--ease-standard),
      translate var(--duration-fast) var(--ease-standard);
  }

  .mobile-nav[open] .menu-lines > span:first-child {
    translate: 0 0.22rem;
    transform: rotate(45deg);
  }

  .mobile-nav[open] .menu-lines > span:last-child {
    translate: 0 -0.22rem;
    transform: rotate(-45deg);
  }

  .mobile-nav nav {
    position: absolute;
    top: calc(100% + var(--space-3));
    right: 0;
    width: min(18.5rem, calc(100vw - 2rem));
    padding: var(--space-2);
    background: var(--color-warm-white);
    border: var(--border-width) solid var(--color-warm-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-elevated);
  }

  .mobile-nav ul {
    display: grid;
    gap: var(--space-1);
  }

  .mobile-nav a {
    display: flex;
    min-height: 3rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.7rem 0.85rem;
    border-radius: 0.7rem;
    text-decoration: none;
  }

  .mobile-nav a:hover {
    background: var(--color-ivory);
  }

  .mobile-nav .menu-contact {
    color: var(--color-white);
    background: var(--color-copper-dark);
  }

  @media (max-width: 22rem) {
    .brand-logo {
      width: 6.15rem;
    }
  }

  @media (min-width: 52rem) {
    .site-header {
      padding-block: var(--space-4);
    }

    .header-shell {
      min-height: 4.5rem;
      gap: var(--space-5);
      padding: 0.55rem 0.6rem 0.55rem 1rem;
    }

    .brand-logo {
      width: clamp(10rem, 14vw, 12rem);
    }

    .desktop-nav,
    .desktop-cta {
      display: block;
    }

    .desktop-nav ul {
      display: flex;
      align-items: center;
      gap: clamp(var(--space-4), 2vw, var(--space-6));
    }

    .desktop-nav a {
      display: inline-flex;
      min-height: 2.75rem;
      min-width: 2.75rem;
      align-items: center;
      position: relative;
      justify-content: center;
      padding-block: var(--space-2);
      font-size: var(--text-sm);
      text-decoration: none;
    }

    .desktop-nav a::after {
      position: absolute;
      right: 0;
      bottom: 0.2rem;
      left: 0;
      height: 1px;
      content: "";
      background: var(--color-copper-dark);
      transform: scaleX(0);
      transform-origin: right;
      transition: transform var(--duration-standard) var(--ease-standard);
    }

    .desktop-nav a:hover::after,
    .desktop-nav a:focus-visible::after {
      transform: scaleX(1);
      transform-origin: left;
    }

    .mobile-nav,
    .mobile-whatsapp {
      display: none;
    }
  }

  @supports not (backdrop-filter: blur(10px)) {
    .header-shell {
      background: var(--color-warm-white);
    }
  }
</style>
