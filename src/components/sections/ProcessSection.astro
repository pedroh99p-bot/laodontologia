---
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import Roller from "../ui/Roller.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import TextRoller from "../ui/TextRoller.astro";

const steps = [
  "Conversa inicial",
  "Avaliação",
  "Planejamento",
  "Acompanhamento",
] as const;
---

<section class="process" id="processo" aria-labelledby="process-title">
  <Container>
    <div class="process-shell" data-reveal>
      <div class="process-heading">
        <p class="section-index" aria-hidden="true">07 / 13</p>
        <SectionHeading
          headingId="process-title"
          eyebrow="Como funciona"
          title="Um fluxo claro para começar a conversa."
          description="A sequência abaixo é uma estrutura visual provisória e será ajustada ao fluxo operacional confirmado pela clínica."
        />
      </div>
      <ol class="timeline">
        {
          steps.map((step, index) => (
            <li>
              <span class="step-number">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div>
                <>
                  <h3>{step}</h3>
                  <p>Etapa em validação pela equipe.</p>
                </>
              </div>
            </li>
          ))
        }
      </ol>
      <Button
        href="https://wa.me/5521971882312"
        icon="chat"
        trackingEvent="whatsapp_click"
        trackingLocation="section"
      >
        Conversar com a equipe
      </Button>
    </div>
    <TextRoller
      items={["Conversa", "Avaliação", "Planejamento", "Acompanhamento"]}
      tone="light"
    />
    <div class="process-roller"><Roller label="Planejamento" /></div>
  </Container>
</section>

<style>
  .process {
    position: relative;
    padding-block: var(--section-space);
    color: var(--color-ivory);
    background: var(--color-graphite);
    overflow: clip;
  }
  .process-shell {
    display: grid;
    gap: var(--space-6);
    max-width: 60rem;
    padding-right: 4rem;
  }
  .process-heading {
    display: grid;
    gap: var(--space-3);
  }
  .process :global(.eyebrow),
  .process :global(.description) {
    color: #d8c6ba;
  }
  .process :global(h2) {
    max-width: 14ch;
    color: var(--color-white);
  }
  .section-index {
    color: #e2b9a1;
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.18em;
  }
  .timeline {
    display: grid;
    gap: var(--space-4);
    border-left: 1px solid rgb(255 255 255 / 30%);
  }
  .timeline li {
    display: grid;
    grid-template-columns: 3.3rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
    margin-left: -0.85rem;
  }
  .step-number {
    display: grid;
    width: 2.7rem;
    height: 2.7rem;
    place-items: center;
    color: var(--color-graphite);
    background: var(--color-copper);
    border-radius: 50%;
    font-size: var(--text-xs);
    font-weight: 800;
  }
  .timeline h3 {
    color: var(--color-white);
  }
  .timeline p {
    margin-top: var(--space-1);
    color: #c4b5aa;
    font-size: var(--text-sm);
  }
  .process :global(.button--primary) {
    width: fit-content;
    color: var(--color-graphite);
    background: var(--color-ivory);
  }
  .process-roller {
    position: absolute;
    z-index: 2;
    top: 5rem;
    right: 0.45rem;
    display: block;
    pointer-events: none;
  }

  .process :global(.text-roller) {
    margin-top: clamp(2.25rem, 6vw, 4rem);
  }

  @media (max-width: 22rem) {
    .process-shell {
      padding-right: 0;
    }

    .process-roller {
      display: none;
    }
  }
  @media (min-width: 70rem) {
    .process-roller {
      top: 50%;
      right: -4.6rem;
      transform: translateY(-50%);
    }
  }
</style>
