---
import { homeCopy } from "../../content/home";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";

const copy = homeCopy.hero;
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <Container>
    <div class="hero-panel">
      <p class="status">{copy.eyebrow}</p>
      <h1 id="hero-title">{copy.heading}</h1>
      <p class="intro">{copy.body}</p>
      <div class="actions">
        <Button href={copy.primaryCta.href}>{copy.primaryCta.label}</Button>
        <Button href={copy.secondaryCta.href} variant="secondary">
          {copy.secondaryCta.label}
        </Button>
      </div>
    </div>
  </Container>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 7rem) var(--section-space);
  }

  .hero-panel {
    display: grid;
    gap: var(--space-5);
    padding: clamp(var(--space-6), 7vw, var(--space-8));
    background: var(--color-warm-white);
    border: var(--border-width) solid var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-surface);
  }

  .status {
    color: var(--color-copper-dark);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 15ch;
  }

  .intro {
    color: var(--color-muted-text);
    font-size: var(--text-lg);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
