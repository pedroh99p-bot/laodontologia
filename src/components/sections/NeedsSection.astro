---
import { preAttendanceIntents } from "../../content/preAttendance";
import Container from "../ui/Container.astro";
import Roller from "../ui/Roller.astro";
import SectionHeading from "../ui/SectionHeading.astro";
---

<section class="needs" id="necessidades" aria-labelledby="needs-title">
  <Container>
    <div class="needs-layout">
      <div class="needs-intro" data-reveal>
        <SectionHeading
          headingId="needs-title"
          eyebrow="Pré-atendimento"
          title="O que você precisa cuidar hoje?"
          description="Escolha o ponto que mais se aproxima do seu momento. Em duas etapas, organizamos o início da conversa com a equipe — sem diagnóstico pelo site."
        />
      </div>

      <ul class="needs-grid" role="list">
        {
          preAttendanceIntents.map((card) => (
            <li data-reveal>
              <button
                type="button"
                data-open-preattendance
                data-quiz-intent={card.title}
                data-quiz-location="needs"
                aria-label={`${card.title}: ${card.description}`}
              >
                <span class="card-topline">
                  <span class="card-emoji" aria-hidden="true">
                    {card.emoji}
                  </span>
                </span>
                <strong>{card.title}</strong>
                <small>{card.description}</small>
                <span class="card-action" aria-hidden="true">
                  Começar <span>↗</span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>

      <button
        class="needs-fallback"
        type="button"
        data-open-preattendance
        data-quiz-location="needs"
      >
        <span aria-hidden="true">👋</span>
        <span>
          <strong>Não sabe qual escolher?</strong>
          Comece pelo assistente de pré-atendimento
        </span>
        <span aria-hidden="true">→</span>
      </button>

      <div class="needs-roller">
        <Roller label="Escuta" />
      </div>
    </div>
  </Container>
</section>

<style>
  .needs {
    position: relative;
    padding-block: var(--section-space);
    overflow: clip;
  }

  .needs-layout {
    position: relative;
    display: grid;
    gap: clamp(var(--space-5), 6vw, var(--space-7));
    padding: clamp(1.35rem, 5vw, 4rem);
    overflow: hidden;
    background:
      radial-gradient(
        circle at 90% 4%,
        rgb(168 84 47 / 10%),
        transparent 18rem
      ),
      var(--color-warm-white);
    border: var(--border-width) solid var(--color-white);
    border-radius: clamp(1.5rem, 5vw, 2.5rem);
    box-shadow: var(--shadow-surface);
  }

  .needs-intro {
    display: grid;
    gap: var(--space-3);
    padding-right: 3.8rem;
  }

  .needs-intro :global(.section-heading) {
    max-width: 46rem;
  }

  .needs-intro :global(h2) {
    max-width: 15ch;
    letter-spacing: -0.025em;
  }

  .needs-intro :global(.description) {
    max-width: 38rem;
  }

  .needs-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.65rem, 2.5vw, 1rem);
  }

  .needs-grid li {
    min-width: 0;
  }

  .needs-grid button {
    display: grid;
    width: 100%;
    min-height: 12.5rem;
    align-content: start;
    gap: var(--space-2);
    padding: clamp(0.85rem, 3vw, 1.3rem);
    color: var(--color-graphite);
    background: rgb(255 255 255 / 74%);
    border: 1px solid rgb(142 63 34 / 16%);
    border-radius: clamp(1rem, 3.5vw, 1.45rem);
    box-shadow: 0 0.7rem 1.8rem rgb(80 37 20 / 6%);
    text-align: left;
    transition:
      transform var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast),
      box-shadow var(--duration-fast),
      background var(--duration-fast);
  }

  .needs-grid button:hover,
  .needs-grid button:focus-visible {
    background: var(--color-white);
    border-color: rgb(142 63 34 / 45%);
    box-shadow: 0 1rem 2.25rem rgb(80 37 20 / 12%);
    transform: translateY(-0.2rem);
  }

  .card-topline,
  .card-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .card-emoji {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    background: rgb(168 84 47 / 10%);
    border-radius: 50%;
    font-size: 1.2rem;
  }

  .needs-grid strong {
    max-width: 12ch;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 4.5vw, 1.45rem);
    font-weight: 500;
    line-height: 1.08;
  }

  .needs-grid small {
    color: var(--color-muted-text);
    font-size: clamp(0.72rem, 2.8vw, var(--text-sm));
    line-height: 1.45;
  }

  .card-action {
    align-self: end;
    margin-top: auto;
    color: var(--color-copper-dark);
    font-size: var(--text-xs);
    font-weight: 800;
  }

  .needs-fallback {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-height: 4.5rem;
    padding: var(--space-3) var(--space-4);
    color: var(--color-white);
    background: var(--color-graphite);
    border: 0;
    border-radius: var(--radius-lg);
    text-align: left;
  }

  .needs-fallback > span:first-child {
    font-size: 1.45rem;
  }

  .needs-fallback > span:nth-child(2) {
    display: grid;
    gap: 0.1rem;
    color: #d8c6ba;
    font-size: var(--text-xs);
  }

  .needs-fallback strong {
    color: var(--color-white);
    font-size: var(--text-sm);
  }

  .needs-roller {
    position: absolute;
    z-index: 2;
    top: 2rem;
    right: 0.45rem;
    display: block;
    pointer-events: none;
  }

  @media (max-width: 22rem) {
    .needs-intro {
      padding-right: 0;
    }

    .needs-roller {
      display: none;
    }

    .needs-grid {
      grid-template-columns: 1fr;
    }

    .needs-grid button {
      min-height: 10.5rem;
    }
  }

  @media (min-width: 48rem) {
    .needs-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .needs-grid button {
      min-height: 13.5rem;
    }

    .needs-fallback {
      width: fit-content;
      max-width: 30rem;
    }
  }

  @media (min-width: 88rem) {
    .needs-intro {
      padding-right: 0;
    }

    .needs-roller {
      top: 50%;
      right: -4.6rem;
      transform: translateY(-50%);
    }
  }
</style>
