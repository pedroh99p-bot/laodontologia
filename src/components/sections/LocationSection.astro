---
import { siteConfig } from "../../config/site";
import { homeCopy } from "../../content/home";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import Icon from "../ui/Icon.astro";
import Roller from "../ui/Roller.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const copy = homeCopy.location;
---

<section class="location" id="localizacao" aria-labelledby="location-title">
  <Container>
    <div class="location-shell" data-reveal>
      <div class="location-copy">
        <SectionHeading
          headingId="location-title"
          eyebrow={copy.eyebrow}
          title={copy.heading}
          description={copy.body}
        />

        <div class="actions">
          <Button
            href={siteConfig.whatsappUrl}
            icon="chat"
            trackingEvent="whatsapp_click"
            trackingLocation="location"
          >
            Falar pelo WhatsApp
          </Button>
          <Button
            href={siteConfig.telephoneHref}
            variant="secondary"
            icon="phone"
            trackingEvent="phone_click"
            trackingLocation="location"
          >
            {siteConfig.phoneDisplay}
          </Button>
          <Button
            href="https://www.google.com/maps/search/?api=1&query=Avenida+das+Am%C3%A9ricas+13685+Sala+278+Rio+de+Janeiro"
            variant="secondary"
            icon="location"
            trackingEvent="route_click"
            trackingLocation="location"
          >
            Traçar rota
          </Button>
        </div>
      </div>

      <address class="address-card">
        <span class="location-icon"><Icon name="location" size={24} /></span>
        <span class="address-label">Onde estamos</span>
        <strong>{siteConfig.address.streetLine}</strong>
        <span>{siteConfig.address.building}</span>
        <span>{siteConfig.address.neighborhood}</span>
        <span>{siteConfig.address.city} — {siteConfig.address.state}</span>
        <a href={siteConfig.instagramUrl}>
          <Icon name="instagram" size={18} />
          @{siteConfig.instagramUsername}
        </a>
      </address>

      <div class="map-card">
        <iframe
          title="Mapa da LA Odontologia no Recreio dos Bandeirantes"
          src="https://www.google.com/maps?q=Avenida%20das%20Am%C3%A9ricas%2C%2013685%2C%20Sala%20278%2C%20Recreio%20dos%20Bandeirantes%2C%20Rio%20de%20Janeiro&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
        <p>
          Mapa provisório por endereço; o Place ID oficial ainda será
          confirmado.
        </p>
      </div>

      <div class="location-roller">
        <Roller label="Localização" />
      </div>
    </div>
  </Container>
</section>

<style>
  .location {
    position: relative;
    padding-block: var(--section-space);
    color: var(--color-ivory);
    background: var(--color-graphite);
    overflow: clip;
  }

  .location::before {
    position: absolute;
    inset: auto -12rem -14rem auto;
    width: 30rem;
    aspect-ratio: 1;
    content: "";
    border: 1px solid rgb(255 255 255 / 8%);
    border-radius: 50%;
    box-shadow:
      0 0 0 4rem rgb(255 255 255 / 2%),
      0 0 0 8rem rgb(255 255 255 / 2%);
  }

  .location-shell {
    position: relative;
    display: grid;
    gap: var(--space-5);
    padding: clamp(1.4rem, 5vw, 4rem);
    background: var(--color-copper-dark);
    border: 1px solid rgb(255 255 255 / 16%);
    border-radius: clamp(1.5rem, 5vw, 2.75rem);
    box-shadow: 0 2rem 5rem rgb(0 0 0 / 16%);
  }

  .location-copy {
    display: grid;
    align-content: center;
    gap: var(--space-5);
  }

  .location :global(.eyebrow),
  .location :global(.description) {
    color: #f4ddd1;
  }

  .location :global(h2) {
    max-width: 12ch;
    color: var(--color-white);
    letter-spacing: -0.03em;
  }

  .location :global(.description) {
    max-width: 36rem;
  }

  .actions {
    display: grid;
    gap: var(--space-3);
  }

  .location :global(.button--primary) {
    color: var(--color-graphite);
    background: var(--color-warm-white);
  }

  .location :global(.button--primary:hover) {
    color: var(--color-white);
    background: var(--color-graphite);
  }

  .location :global(.button--secondary) {
    color: var(--color-white);
    border-color: rgb(255 255 255 / 68%);
  }

  .location :global(.button--secondary:hover) {
    color: var(--color-graphite);
    background: var(--color-white);
  }

  .address-card {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.35rem;
    min-height: 19rem;
    padding: clamp(1.4rem, 5vw, 2.5rem);
    overflow: hidden;
    color: var(--color-graphite);
    background: var(--color-warm-white);
    border-radius: clamp(1.2rem, 4vw, 2rem);
    font-style: normal;
  }

  .address-card::after {
    position: absolute;
    right: -4rem;
    bottom: -5rem;
    width: 12rem;
    aspect-ratio: 1;
    content: "";
    border: 1px solid rgb(168 84 47 / 18%);
    border-radius: 50%;
    box-shadow:
      0 0 0 2rem rgb(168 84 47 / 5%),
      0 0 0 4rem rgb(168 84 47 / 4%);
  }

  .location-icon {
    display: grid;
    width: 3.25rem;
    height: 3.25rem;
    place-items: center;
    margin-bottom: var(--space-4);
    color: var(--color-white);
    background: var(--color-copper-dark);
    border-radius: 50%;
  }

  .address-label {
    color: var(--color-copper-dark);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .address-card strong {
    max-width: 18ch;
    margin-block: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 400;
    line-height: var(--leading-heading);
  }

  .address-card > span:not(.location-icon, .address-label) {
    color: var(--color-muted-text);
    line-height: 1.45;
  }

  .address-card a {
    position: relative;
    z-index: 2;
    display: inline-flex;
    width: fit-content;
    min-height: 2.75rem;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    color: var(--color-copper-dark);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
  }

  .map-card {
    display: grid;
    gap: var(--space-2);
    overflow: hidden;
    color: #f4ddd1;
    background: rgb(36 35 33 / 35%);
    border: 1px solid rgb(255 255 255 / 16%);
    border-radius: clamp(1.2rem, 4vw, 2rem);
  }

  .map-card iframe {
    width: 100%;
    min-height: 18rem;
    border: 0;
    filter: saturate(0.75) contrast(0.92);
  }

  .map-card p {
    padding: 0 var(--space-4) var(--space-4);
    font-size: var(--text-xs);
    opacity: 0.78;
  }

  .location-roller {
    display: none;
  }

  @media (min-width: 31rem) {
    .actions {
      display: flex;
      flex-wrap: wrap;
    }
  }

  @media (min-width: 58rem) {
    .location-shell {
      grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
      align-items: stretch;
    }

    .location-copy {
      padding-right: clamp(var(--space-4), 3vw, var(--space-7));
    }

    .address-card {
      min-height: 27rem;
    }

    .map-card {
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 1fr) 15rem;
      align-items: center;
    }

    .map-card iframe {
      min-height: 14rem;
    }
  }

  @media (min-width: 88rem) {
    .location-roller {
      position: absolute;
      top: 50%;
      left: -4.6rem;
      display: block;
      transform: translateY(-50%);
    }

    .location-roller :global(.roller) {
      color: var(--color-warm-white);
      background: rgb(255 255 255 / 8%);
      border-color: rgb(255 255 255 / 16%);
      box-shadow: none;
    }
  }
</style>
