---
import { homeCopy } from "../../content/home";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";

const copy = homeCopy.finalCta;
---

<section class="final-cta" id="contato" aria-labelledby="final-cta-title">
  <Container>
    <div class="panel">
      <div>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h2 id="final-cta-title">{copy.heading}</h2>
        <p>{copy.body}</p>
      </div>
      <Button href={copy.primaryCta.href}>{copy.primaryCta.label}</Button>
    </div>
  </Container>
</section>

<style>
  .final-cta {
    padding-block: var(--section-space);
  }

  .panel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding: clamp(var(--space-5), 5vw, var(--space-7));
    background: var(--color-warm-white);
    border: var(--border-width) solid var(--color-warm-border);
    border-radius: var(--radius-lg);
  }

  .eyebrow {
    margin-bottom: var(--space-2);
    color: var(--color-copper-dark);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
</style>
