---
import { homeCopy } from "../../content/home";
import { professionals } from "../../content/professionals";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const copy = homeCopy.professionals;
---

<section
  class="specialists"
  id="profissionais"
  aria-labelledby="professionals-title"
>
  <Container>
    <SectionHeading
      headingId="professionals-title"
      eyebrow={copy.eyebrow}
      title={copy.heading}
      description={copy.body}
    />
    <ul class="professional-list" role="list">
      {
        professionals.map((professional) => (
          <li>
            <h3>{professional.displayName}</h3>
            <p>{professional.cro}</p>
          </li>
        ))
      }
    </ul>
  </Container>
</section>

<style>
  .specialists {
    padding-block: var(--section-space);
  }

  .professional-list {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .professional-list li {
    padding: var(--space-5);
    background: var(--color-warm-white);
    border: var(--border-width) solid var(--color-warm-border);
    border-radius: var(--radius-md);
  }

  .professional-list p {
    margin-top: var(--space-2);
    color: var(--color-copper-dark);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (min-width: 40rem) {
    .professional-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
