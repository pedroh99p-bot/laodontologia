---
import { media } from "../../config/media";
import { results } from "../../content/results";
import { transformCloudinaryUrl } from "../../lib/cloudinary";
import Container from "../ui/Container.astro";
import Roller from "../ui/Roller.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import TextRoller from "../ui/TextRoller.astro";

const gallery = results.map((result) => {
  const asset = media[result.mediaKey].asset;

  if (!asset) {
    throw new Error(`Asset ausente para ${result.slug}.`);
  }

  const buildSource = (format: "avif" | "webp") =>
    transformCloudinaryUrl(asset.url, [
      `f_${format}`,
      "q_auto:good",
      "c_pad",
      "b_rgb:f7f2ec",
      "w_640",
      "h_780",
    ]);

  return {
    ...result,
    asset,
    webp: buildSource("webp"),
  };
});
---

<section class="results" id="resultados" aria-labelledby="results-title">
  <Container>
    <div class="results-shell" data-reveal>
      <div class="results-heading">
        <SectionHeading
          headingId="results-title"
          eyebrow="Resultados"
          title="Resultados que respeitam cada sorriso."
          description="Comparativos fornecidos pela equipe da LA Odontologia. Cada resultado é individual e depende de avaliação profissional."
        />
      </div>

      <div
        class="results-viewport"
        role="region"
        aria-label="Galeria automática de resultados odontológicos"
        data-results-gallery
      >
        <div class="results-track">
          <div class="results-sequence">
            {
              gallery.map((result, index) => (
                <figure
                  class="result-frame"
                  data-protected-result
                  aria-label={`Resultado ${index + 1} de ${gallery.length}`}
                >
                  <img
                    src={result.webp}
                    data-result-image
                    data-fallback-src={result.asset.url}
                    width="640"
                    height="780"
                    alt={result.asset.alt}
                    loading="eager"
                    decoding="async"
                    draggable="false"
                  />
                </figure>
              ))
            }
          </div>

          <div class="results-sequence" aria-hidden="true">
            {
              gallery.map((result) => (
                <figure class="result-frame" data-protected-result>
                  <img
                    src={result.webp}
                    data-result-image
                    data-fallback-src={result.asset.url}
                    width="640"
                    height="780"
                    alt=""
                    loading="eager"
                    decoding="async"
                    draggable="false"
                  />
                </figure>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <TextRoller
      items={["Resultados", "Naturalidade", "Planejamento", "Cuidado"]}
    />
    <div class="results-roller"><Roller label="Naturalidade" /></div>
  </Container>
</section>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-results-gallery]")
    .forEach((gallery) => {
      const images = Array.from(
        gallery.querySelectorAll<HTMLImageElement>("[data-result-image]"),
      );

      images.forEach((image) => {
        image.addEventListener(
          "error",
          () => {
            const fallback = image.dataset.fallbackSrc;
            if (fallback && image.src !== fallback) image.src = fallback;
          },
          { once: true },
        );
      });

      if (!("IntersectionObserver" in window)) {
        gallery.classList.add("is-running");
        return;
      }

      const observer = new IntersectionObserver(
        ([entry]) => {
          gallery.classList.toggle(
            "is-running",
            entry?.isIntersecting ?? false,
          );
        },
        { rootMargin: "20% 0px" },
      );

      observer.observe(gallery);
    });

  document
    .querySelectorAll<HTMLElement>("[data-protected-result]")
    .forEach((media) => {
      media.addEventListener("contextmenu", (event) => event.preventDefault());
      media.addEventListener("dragstart", (event) => event.preventDefault());
    });
</script>

<style>
  @keyframes results-gallery-loop {
    to {
      transform: translateX(calc(-50% - 0.325rem));
    }
  }

  .results {
    position: relative;
    padding-block: var(--section-space);
    background: var(--color-warm-white);
    overflow: clip;
  }

  .results :global(.container) {
    position: relative;
  }

  .results-shell {
    display: grid;
    gap: clamp(var(--space-6), 7vw, var(--space-8));
  }

  .results-heading {
    display: grid;
    gap: var(--space-3);
    max-width: 52rem;
    padding-right: 4rem;
  }

  .results-heading :global(h2) {
    max-width: 14ch;
  }

  .results-viewport {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
    pointer-events: none;
    touch-action: pan-y;
    user-select: none;
  }

  .results-track {
    display: flex;
    width: max-content;
    gap: 0.65rem;
    padding-block: 0.5rem 1.5rem;
    animation: results-gallery-loop 44s linear infinite;
    animation-play-state: paused;
    will-change: transform;
  }

  .results-viewport.is-running .results-track {
    animation-play-state: running;
  }

  .results-sequence {
    display: flex;
    gap: 0.65rem;
  }

  .result-frame {
    flex: 0 0 clamp(15.5rem, 72vw, 22rem);
    aspect-ratio: 640 / 780;
    overflow: hidden;
    background: var(--color-ivory);
    border: 1px solid var(--color-white);
    border-radius: clamp(1rem, 4vw, 1.65rem);
    box-shadow: 0 1rem 2.5rem rgb(80 37 20 / 14%);
    -webkit-touch-callout: none;
    user-select: none;
  }

  .result-frame img {
    width: 100%;
    height: 100%;
  }

  .result-frame img {
    display: block;
    object-fit: contain;
    pointer-events: none;
  }

  .results-roller {
    position: absolute;
    z-index: 2;
    top: 5rem;
    right: 0.45rem;
    display: block;
    pointer-events: none;
  }

  .results :global(.text-roller) {
    margin-top: clamp(2.25rem, 6vw, 4rem);
  }

  @media (max-width: 22rem) {
    .results-heading {
      padding-right: 0;
    }

    .results-roller {
      display: none;
    }
  }

  @media (min-width: 48rem) {
    .result-frame {
      flex-basis: clamp(20rem, 36vw, 26rem);
    }
  }

  @media (min-width: 70rem) {
    .results-roller {
      top: 50%;
      right: -4.6rem;
      transform: translateY(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .results-track {
      animation: none;
      transform: none;
    }

    .results-sequence[aria-hidden="true"] {
      display: none;
    }
  }
</style>
