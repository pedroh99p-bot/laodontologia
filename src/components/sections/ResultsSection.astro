---
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import Roller from "../ui/Roller.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import TextRoller from "../ui/TextRoller.astro";

const cards = [
  "Caso autorizado pendente",
  "Contexto clínico pendente",
  "Imagem aprovada pendente",
] as const;
---

<section class="results" id="resultados" aria-labelledby="results-title">
  <Container>
    <div class="results-shell" data-reveal>
      <div class="results-heading">
        <p class="section-index" aria-hidden="true">03</p>
        <SectionHeading
          headingId="results-title"
          eyebrow="Resultados"
          title="Resultados apresentados com contexto e responsabilidade."
          description="A estrutura está pronta para receber casos reais somente após consentimento, revisão clínica e aprovação da equipe."
        />
      </div>
      <div
        class="results-scroller"
        aria-label="Prévia estrutural de resultados"
      >
        {
          cards.map((card, index) => (
            <article
              class:list={[
                "result-card",
                { "result-card--featured": index === 0 },
              ]}
            >
              <span class="preview-tag">Preview estrutural</span>
              <div class="result-visual" aria-hidden="true">
                <>
                  <span class="result-visual__arc" />
                  <span class="result-visual__dot" />
                </>
              </div>
              <h3>{card}</h3>
              <p>Sem imagem de paciente ou promessa clínica nesta fase.</p>
            </article>
          ))
        }
      </div>
      <div class="comparison">
        <div class="comparison-copy">
          <span class="preview-tag">Comparador preparado</span>
          <h3>Antes e depois</h3>
          <p>
            O comparador permanece neutro até a chegada de um caso autorizado.
          </p>
        </div>
        <div class="comparison-frame">
          <div class="comparison-side comparison-side--before">
            Imagem anterior pendente
          </div>
          <div class="comparison-side comparison-side--after">
            Imagem posterior pendente
          </div>
          <input
            type="range"
            min="0"
            max="100"
            value="50"
            aria-label="Revelar a comparação antes e depois"
          />
          <span class="comparison-handle" aria-hidden="true"></span>
        </div>
      </div>
      <Button
        href="/#contato"
        variant="secondary"
        trackingEvent="result_interaction"
        trackingLocation="section">Falar com a equipe</Button
      >
    </div>
    <TextRoller items={["Cuidado", "Naturalidade", "Confiança", "Contexto"]} />
    <div class="results-roller"><Roller label="Naturalidade" /></div>
  </Container>
</section>

<script>
  document
    .querySelectorAll<HTMLElement>(".comparison-frame")
    .forEach((frame) => {
      const input = frame.querySelector<HTMLInputElement>("input");
      const handle = frame.querySelector<HTMLElement>(".comparison-handle");
      if (!input || !handle) return;
      const update = () => {
        frame.style.setProperty("--split", `${input.value}%`);
        handle.style.left = `${input.value}%`;
      };
      input.addEventListener("input", update);
      update();
    });
</script>

<style>
  .results {
    position: relative;
    padding-block: var(--section-space);
    background: var(--color-warm-white);
    overflow: clip;
  }
  .results-shell {
    display: grid;
    gap: clamp(var(--space-5), 4vw, var(--space-7));
  }
  .results-heading {
    display: grid;
    gap: var(--space-3);
    max-width: 50rem;
  }
  .section-index {
    color: var(--color-copper);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.18em;
  }
  .results-scroller {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(15rem, 84%);
    gap: var(--space-4);
    overflow-x: auto;
    padding-bottom: var(--space-2);
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }
  .result-card {
    display: grid;
    gap: var(--space-3);
    padding: clamp(1.25rem, 4vw, 2rem);
    scroll-snap-align: start;
    background: var(--color-ivory);
    border: 1px solid var(--color-warm-border);
    border-radius: var(--radius-lg);
  }
  .result-card--featured {
    color: var(--color-white);
    background: var(--color-copper-dark);
    border-color: transparent;
  }
  .preview-tag {
    width: fit-content;
    padding: 0.3rem 0.55rem;
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.78;
  }
  .result-visual {
    position: relative;
    display: grid;
    min-height: 10rem;
    place-items: center;
    overflow: hidden;
    background: color-mix(in srgb, currentColor 9%, transparent);
    border-radius: var(--radius-md);
  }
  .result-visual__arc {
    width: 9rem;
    height: 9rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    opacity: 0.42;
  }
  .result-visual__dot {
    position: absolute;
    width: 1rem;
    height: 1rem;
    background: currentColor;
    border-radius: 50%;
  }
  .result-card p,
  .comparison p {
    color: inherit;
    opacity: 0.74;
  }
  .comparison {
    display: grid;
    gap: var(--space-5);
    padding: clamp(1.25rem, 4vw, 2rem);
    background: var(--color-graphite);
    border-radius: var(--radius-lg);
    color: var(--color-ivory);
  }
  .comparison-copy {
    display: grid;
    gap: var(--space-3);
    align-content: center;
  }
  .comparison-frame {
    position: relative;
    display: grid;
    min-height: 14rem;
    overflow: hidden;
    background: #b9afa8;
    border-radius: var(--radius-md);
  }
  .comparison-side {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: var(--space-4);
    text-align: center;
    font-size: var(--text-sm);
  }
  .comparison-side--before {
    background: #c8beb6;
    color: var(--color-graphite);
  }
  .comparison-side--after {
    width: var(--split, 50%);
    overflow: hidden;
    background: #8e7769;
    color: var(--color-white);
  }
  .comparison-frame input {
    position: absolute;
    z-index: 2;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: ew-resize;
    opacity: 0;
  }
  .comparison-handle {
    position: absolute;
    z-index: 1;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-white);
    transform: translateX(-1px);
    pointer-events: none;
  }
  .results-roller {
    display: none;
  }
  @media (min-width: 48rem) {
    .results-scroller {
      grid-auto-columns: minmax(18rem, 32%);
    }
    .comparison {
      grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1.3fr);
      align-items: center;
    }
  }
  @media (min-width: 70rem) {
    .results-roller {
      position: absolute;
      top: 50%;
      right: -4.6rem;
      display: block;
      transform: translateY(-50%);
    }
  }
</style>
