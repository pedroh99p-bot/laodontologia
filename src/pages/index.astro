---
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import FinalCTASection from "../components/sections/FinalCTASection.astro";
import ClinicSection from "../components/sections/ClinicSection.astro";
import DifferentialsSection from "../components/sections/DifferentialsSection.astro";
import FaqSection from "../components/sections/FaqSection.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import LocationSection from "../components/sections/LocationSection.astro";
import NeedsSection from "../components/sections/NeedsSection.astro";
import ProcessSection from "../components/sections/ProcessSection.astro";
import ProfessionalsSection from "../components/sections/ProfessionalsSection.astro";
import ResultsSection from "../components/sections/ResultsSection.astro";
import TreatmentsSection from "../components/sections/TreatmentsSection.astro";
import TrustStrip from "../components/sections/TrustStrip.astro";
import { homeSections } from "../config/home-sections";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  {homeSections.navbar.enabled && <Header overlay />}
  <main id="conteudo">
    {homeSections.hero.enabled && <HeroSection />}
    {homeSections.trust.enabled && <TrustStrip />}
    {homeSections.needs.enabled && <NeedsSection />}
    {homeSections.results.enabled && <ResultsSection />}
    {homeSections.professionals.enabled && <ProfessionalsSection />}
    {homeSections.treatments.enabled && <TreatmentsSection />}
    {homeSections.process.enabled && <ProcessSection />}
    {homeSections.clinic.enabled && <ClinicSection />}
    {homeSections.differentials.enabled && <DifferentialsSection />}
    {homeSections.location.enabled && <LocationSection />}
    {homeSections.faq.enabled && <FaqSection />}
    {homeSections.finalCta.enabled && <FinalCTASection />}
  </main>
  {homeSections.footer.enabled && <Footer />}
</BaseLayout>
